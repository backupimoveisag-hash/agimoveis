rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function profile() { return get(userPath()).data; }
    function active() { return hasProfile() && profile().active == true; }
    function admin() { return active() && profile().role == 'Administrador'; }
    function hasPerm(p) { return admin() || (active() && profile().permissions is list && profile().permissions.hasAny([p])); }
    function selfEmail(email) { return signedIn() && request.auth.token.email != null && request.auth.token.email == email; }
    function canWriteSection(sectionId) {
      return admin()
        || (sectionId in ['activities','timeline'] && active())
        || (sectionId in ['properties','prospectings'] && hasPerm('imoveis'))
        || (sectionId == 'owners' && hasPerm('proprietarios'))
        || (sectionId == 'leads' && hasPerm('leads'))
        || (sectionId in ['tasks','siteEvents'] && hasPerm('atendimento'))
        || (sectionId == 'automation' && hasPerm('configuracoes'))
        || (sectionId == 'clients' && hasPerm('clientes'))
        || (sectionId == 'appointments' && hasPerm('agenda'))
        || (sectionId in ['keys','keyMovements'] && (hasPerm('chaves') || hasPerm('imoveis') || hasPerm('agenda')))
        || (sectionId in ['proposals','contracts'] && hasPerm('propostas'))
        || (sectionId in ['commissions','finance'] && hasPerm('financeiro'))
        || (sectionId == 'users' && hasPerm('equipe'))
        || (sectionId == 'settings' && hasPerm('configuracoes'));
    }

    match /system/bootstrap {
      allow read: if signedIn();
      // Primeiro usuário autenticado inicializa o CRM uma única vez.
      // O perfil Administrador é criado logo depois em users/{uid}.
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/system/bootstrap)
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.initialized == true;
      allow update, delete: if admin();
    }

    match /users/{uid} {
      // Primeiro UID definido em system/bootstrap pode criar o próprio perfil Administrador.
      // Todos os demais auto-cadastros só podem criar perfil Corretor pendente; aprovação é administrativa.
      allow read: if signedIn() && (uid == request.auth.uid || admin() || hasPerm('equipe'));
      allow create: if admin()
        || (signedIn() && uid == request.auth.uid
            && exists(/databases/$(database)/documents/system/bootstrap)
            && get(/databases/$(database)/documents/system/bootstrap).data.adminUid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role == 'Administrador'
            && request.resource.data.active == true
            && request.resource.data.approvalStatus == 'approved')
        || (signedIn() && uid == request.auth.uid && request.auth.token.email != null
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role == 'Corretor'
            && request.resource.data.permissions is list
            && request.resource.data.permissions.size() == 0
            && request.resource.data.active == false
            && request.resource.data.approvalStatus == 'pending')
        ;
      allow update: if admin()
        || (signedIn() && uid == request.auth.uid
            && resource.data.approvalStatus == 'pending'
            && request.resource.data.approvalStatus == 'pending'
            && request.resource.data.active == false
            && request.resource.data.role == 'Corretor'
            && request.resource.data.permissions is list
            && request.resource.data.permissions.size() == 0
            && request.resource.data.email == request.auth.token.email);
      allow delete: if admin();
    }

    match /accessRequests/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || admin());
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email;
      allow update: if admin()
        || (signedIn() && uid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.email == request.auth.token.email);
      allow delete: if admin();
    }

    match /accessInvites/{email} {
      allow read: if admin() || selfEmail(email);
      allow write: if admin();
    }

    match /workspaces/{workspaceId} {
      allow read: if active();
      allow write: if active();
      match /sections/{sectionId} {
        allow read: if active();
        allow create: if canWriteSection(sectionId);
        // Em properties, corretores podem cadastrar/editar, mas somente Administrador pode reduzir a carteira.
        allow update: if canWriteSection(sectionId)
          && (sectionId != 'properties'
              || admin()
              || (resource.data.value is list
                  && request.resource.data.value is list
                  && request.resource.data.value.size() >= resource.data.value.size()));
        allow delete: if admin();
      }
    }

    match /public/catalog {
      allow read: if true;
      allow write: if active() && (hasPerm('site') || hasPerm('imoveis'));
    }

    match /siteLeads/{leadId} {
      allow create: if request.resource.data.processed == false;
      allow read, update: if active() && (hasPerm('leads') || hasPerm('atendimento'));
      allow delete: if admin();
    }
  }
}
